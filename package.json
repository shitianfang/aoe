{
  "name": "aoe",
  "version": "0.4.1",
  "private": true,
  "description": "AOE — a calm desktop workspace for proactive, self-improving, multi-agent work",
  "author": "shitianfang",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 3000 --host",
    "bridge": "node electron/bridge.mjs",
    "core:install": "npm --prefix core install",
    "core:build": "npm --prefix core run build",
    "core:pull": "git subtree pull --prefix=core https://github.com/shitianfang/prime-agent.git main --squash",
    "build": "tsc --noEmit && vite build",
    "app": "electron .",
    "dist:win": "vite build && electron-builder --win --publish never",
    "dist:mac": "vite build && electron-builder --mac --publish never",
    "dist:linux": "vite build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "ai.primeintellect.aoe",
    "productName": "AOE",
    "files": [
      "dist/**",
      "electron/**",
      "skills/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Utility"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shitianfang/aoe.git"
  },
  "homepage": "https://github.com/shitianfang/aoe"
}
